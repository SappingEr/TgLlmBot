{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "Telegram": {
        "BotToken": "<BOT_TOKEN_HERE>",
        "AllowedChatIds": [],
        "BotName": "Альфа",
        "CollapseLongResponses": true,
        "ResponseCollapseCharacterThreshold": 600,
        "ResponseCollapseLineThreshold": 8
    },
    "Llm": {
        "Endpoint": "http://localhost:1234",
        "ApiKey": "<LLM_API_KEY_HERE>",
        "Model": "default",
        "DefaultResponse": "Не удалось получить ответ от LLM",
        "Capabilities": {
            "Image": true,
            "Video": true,
            "Audio": false
        }
    },
    "DataAccess": {
        "PostgresConnectionString": "Host=localhost;Port=5432;Database=tgbot;Username=postgres;Password=postgres;"
    },
    "Mcp": {
        "Github": {
            "Enabled": true,
            "Endpoint": "https://api.githubcopilot.com/mcp/",
            "PersonalAccessToken": "<YOUR_GITHUB_PAT>"
        },
        "Exa": {
            "Enabled": true,
            "Endpoint": "https://mcp.exa.ai/mcp",
            "ApiKey": "<YOUR_EXA_API_KEY>"
        }
    }
}
